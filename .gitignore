# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing
/test-results
/playwright-report

!.env.example

# --- Suit Lab: private/local data (never commit) ---
