# Suit Lab — example environment. Copy to .env.local. NEVER commit real values.
# Empty values are treated as "not set".

# --- Database (Neon Postgres) ---
# Unset locally → an embedded PGlite database in DATA_DIR is used (dev/e2e only).
DATABASE_URL=                 # pooled connection string (app)
DATABASE_URL_UNPOOLED=        # direct connection string (migrations: npm run db:migrate)

# --- Sessions ---
SESSION_SECRET=               # 32+ random chars. Required in production.

# --- Object storage (Cloudflare R2, S3-compatible). Bucket must be PRIVATE (no public access). ---
# Unset locally → files go to DATA_DIR/storage and are served via signed /api/files URLs.
STORAGE_PROVIDER=             # r2 | local   (production requires r2)
STORAGE_BUCKET=
STORAGE_ENDPOINT=             # https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=           # R2 API token access key id (Object Read & Write, this bucket only)
STORAGE_SECRET_KEY=
SIGNED_URL_TTL_SECONDS=3600

# --- Virtual try-on ---
VIRTUAL_TRYON_PROVIDER=mock   # mock | fashn. No real call is possible unless this is fashn AND a key is set.
FASHN_API_KEY=                # server-only. Never prefix with NEXT_PUBLIC_.
FASHN_MODEL=tryon-v1.6        # tryon-v1.6 (stable, 1 credit) | tryon-max (preview, 1–5 credits)
FASHN_MODE=                   # v1.6: performance|balanced|quality (default quality); max: fast|balanced|quality (default balanced)
FASHN_RESOLUTION=1k           # tryon-max only: 1k | 2k | 4k
FASHN_RETURN_BASE64=true      # true = FASHN keeps output 60 min instead of 3 days

# --- Cost protection ---
GENERATION_USER_HOURLY_LIMIT=20
GENERATION_GLOBAL_DAILY_LIMIT=200
GENERATION_MAX_IN_FLIGHT=4    # FASHN allows 6 concurrent
GENERATION_TIMEOUT_SECONDS=240
PROFILE_USER_HOURLY_LIMIT=10

# --- Local only ---
DATA_DIR=.data
