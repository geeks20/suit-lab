# Suit Lab — example environment. Copy to .env.local. Never commit real values.
#
# Phase 1 (current) needs NONE of these: everything runs in the browser with
# the mock try-on provider. They are listed so later phases have one home.

# --- Phase 2: database (Postgres) ---
DATABASE_URL=

# --- Phase 2: object storage for photos and generated looks (S3 / Cloudflare R2) ---
STORAGE_PROVIDER=        # s3 | r2
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Phase 2/3: virtual try-on ---
VIRTUAL_TRYON_PROVIDER=mock   # mock | fashn
FASHN_API_KEY=                # server-only. Never prefix with NEXT_PUBLIC_.

# --- Phase 5: AI stylist ---
OPENAI_API_KEY=               # server-only
